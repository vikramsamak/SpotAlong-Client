# MySQL connection used by Prisma
DATABASE_URL="mysql://root:password@localhost:3306/spotalong"

# Secret used to sign access JWTs
JWT_SECRET="change-me"

# HTTP port for the server
PORT=3000

# Spotify OAuth application credentials
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/login/callback"
