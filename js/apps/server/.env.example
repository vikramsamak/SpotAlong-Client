# MySQL connection used by Prisma
DATABASE_URL="mysql://root:password@localhost:3306/spotalong"

# Secret used to sign access JWTs
JWT_SECRET="change-me"

# HTTP port for the server
PORT=3000

# Spotify OAuth application credentials
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Spotify OAuth application credentials
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Exact redirect URI Spotify sends the browser back to after authorization.
# MUST be registered verbatim in the Spotify dashboard. Note: http://localhost
# is rejected by Spotify - use http://127.0.0.1 (dev) or https (tunnel/prod).
# Examples:
#   SPOTIFY_LOGIN_REDIRECT_URL="http://127.0.0.1:5173/auth/callback"   (SPA dev)
#   SPOTIFY_LOGIN_REDIRECT_URL="https://<your-sub>.ngrok-free.app/auth/callback"
# When unset, the server derives one from the request host pointing at
# /api/login/callback on this API instead.
SPOTIFY_LOGIN_REDIRECT_URL=""

# Public tunnel (optional). Uses an auto-generated ngrok domain.
# When enabled, prefer the printed ngrok URL for SPOTIFY_REDIRECT_URI above.
NGROK_ENABLED="false"
NGROK_AUTHTOKEN=""
