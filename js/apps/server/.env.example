# MySQL connection used by Prisma
DATABASE_URL="mysql://root:password@localhost:3306/spotalong"

# Secret used to sign access JWTs
JWT_SECRET="change-me"

# HTTP port for the server
PORT=3000

# Spotify OAuth application credentials
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Optional deterministic base URL used for the Spotify OAuth redirect.
# When unset, the redirect URI is derived from the incoming request host,
# so it works automatically through localhost, ngrok tunnels, or a reverse
# proxy (the exact URI must still be registered in the Spotify dashboard).
APP_BASE_URL=""

# Legacy fallback; no longer used for OAuth when APP_BASE_URL is unset.
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/login/callback"

# Public tunnel (optional). Uses an auto-generated ngrok domain.
# When enabled, prefer the printed ngrok URL for SPOTIFY_REDIRECT_URI above.
NGROK_ENABLED="false"
NGROK_AUTHTOKEN=""
